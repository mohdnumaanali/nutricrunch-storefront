  "reviews": [
    {
      "id": "rev-01",
      "name": "Sravanthi P.",
      "location": "Hanamkonda",
      "rating": 5,
      "comment": "The aroma and rich taste of pure cow desi ghee in the panjiri is simply exceptional! You can taste the slow-roasted crunchy almonds, cashews, and lotus seeds in every bite. Organic jaggery gives it the perfect wholesome sweetness without feeling heavy.",
      "verified": true,
      "productName": "NutriCrunch Dry Fruits Panjiri",
      "createdAt": "2026-10-17T10:59:49.013Z",
      "status": "published"
    },
    {
      "id": "rev-02",
      "name": "Rahul M.",
      "location": "Kazipet",
      "rating": 5,
      "comment": "The crispiness of the coconut oil banana chips is unbeatable! Unlike commercial market chips, these have zero palm oil grease, just delicate rock salt and pure cold-pressed coconut oil flavor. Delivered super fresh to our door in Kazipet.",
      "verified": true,
      "productName": "NutriCrunch Banana Chips",
      "createdAt": "2026-10-22T10:59:49.013Z",
      "status": "published"
    },
    {
      "id": "rev-03",
      "name": "Ananya R.",
      "location": "Warangal",
      "rating": 5,
      "comment": "Both the pure desi ghee panjiri and the Kerala-style banana chips are extraordinary! The panjiri gives our family long-lasting morning energy, and the chips are so light and crackling crisp. Proud to have such high quality food crafted locally!",
      "verified": true,
      "productName": "Panjiri & Banana Chips Combo",
      "createdAt": "2026-10-27T10:59:49.013Z",
      "status": "published"
    }
  ]
